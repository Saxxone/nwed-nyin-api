DATABASE_URL=
SHADOW_DATABASE_URL=
# Production site; comma-separated for multiple. When NODE_ENV !== "production", common localhost origins are allowed automatically (see corsAllowedOrigins in main.ts).
UI_BASE_URL=https://www.nwednyin.org
# Optional extra allowed CORS origins (comma-separated).
CORS_ORIGINS=
# Set to 1 to allow localhost CORS origins even when NODE_ENV=production (e.g. staging).
CORS_ALLOW_LOCALHOST=
DEFAULT_PROFILE_IMG=
GOOGLE_AUTH_CLIENT_ID=
# Stored in DB; must match frontend URL rewriting (usually /public for files -> /articles/files/...).
FILE_BASE_URL=/public
JWT_SECRET=
JWT_REFRESH_SECRET=
REDIS_HOST=
REDIS_PORT=
